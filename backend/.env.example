# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# MongoDB connection string, e.g. from MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>

# Port the API listens on
PORT=5000

# Optional: other sites allowed to call the API, comma-separated.
# Leave empty when the frontend is served from the same domain (the default).
CORS_ORIGIN=
